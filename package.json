{
  "name": "architecture-rules",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable architecture and code-quality rules for TypeScript and React projects.",
  "type": "module",
  "files": [
    "dist",
    "tsconfig.base.json",
    "README.md",
    "examples"
  ],
  "bin": {
    "architecture-rules": "./dist/cli.js",
    "architecture-check": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "scripts": {
    "build:typescript": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "generate": "node dist/generateTsconfig.js",
    "build": "pnpm run build:typescript && pnpm run generate",
    "test": "node node_modules/vitest/vitest.mjs run",
    "check": "pnpm run build && pnpm run typecheck && pnpm test",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "test:architecture": "node node_modules/vitest/vitest.mjs run tests/architecture.test.ts tests/architectureProjects.test.ts tests/architectureCli.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "picomatch": "^4.0.7",
    "typescript": "7.0.2",
    "eslint": "^10.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "oxlint": "1.80.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
