#!/bin/sh
# Rebuilds dist/ and docs/rules/, then stops the commit if
# the rebuilt files differ from what is staged.
# Enable once per clone: git config core.hooksPath .githooks
set -eu

cd "$(git rev-parse --show-toplevel)"

pnpm -s run build

untracked=$(git ls-files --others --exclude-standard -- dist docs)

if git diff --quiet -- dist docs && [ -z "$untracked" ]; then
  exit 0
fi

echo "pre-commit: generated files are out of date:" >&2
git status --short -- dist docs >&2
echo "Stage them and commit again: git add dist docs" >&2
exit 1
